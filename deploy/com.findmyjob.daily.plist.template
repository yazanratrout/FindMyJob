<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Belt-and-braces daily pipeline run via launchd, independent of the API server.
  The in-process scheduler already runs the pipeline at the time you set in the
  UI; this fallback covers the server being down. The pipeline is idempotent, so
  a double run costs almost nothing (dedup + LLM cache).

  Install:  just install-launchd
  Change the time: edit StartCalendarInterval below, then reinstall.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.findmyjob.daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>__VENV_PYTHON__</string>
    <string>-m</string>
    <string>findmyjob</string>
    <string>pipeline</string>
    <string>run</string>
    <string>--trigger</string>
    <string>schedule</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__REPO__</string>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>10</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__REPO__/data/logs/launchd.daily.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/logs/launchd.daily.err.log</string>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>

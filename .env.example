# =============================================================================
# FindMyJob — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_ENV=development
# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
# Where runtime data lives (SQLite db, uploaded documents, generated letters,
# embedding model cache). Defaults to `<repo>/data` if unset.
# APP_DATA_DIR=/Users/you/Library/Application Support/FindMyJob
# Override the DB URL if you don't want the default sqlite file under APP_DATA_DIR.
# APP_DATABASE_URL=sqlite:///./data/findmyjob.db
APP_HOST=127.0.0.1
APP_PORT=8000

# ---- LLM (Anthropic / Claude) ---------------------------------------------
ANTHROPIC_API_KEY=
# Model routing — cheap model for bulk extraction, capable model for judgement
# and cover letters. Override only if you know why.
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
LLM_MODEL_SMART=claude-sonnet-5
# Hard ceiling on spend per calendar month, in EUR. The pipeline stops making
# LLM calls once month-to-date cost would exceed this.
LLM_MONTHLY_BUDGET_EUR=10

# ---- Job source: Bundesagentur fuer Arbeit (Jobsuche API) -----------------
# Register at https://jobsuche.api.bund.dev / https://www.arbeitsagentur.de
BA_API_CLIENT_ID=
BA_API_CLIENT_SECRET=

# ---- Job source: Adzuna --------------------------------------------------
# Free API key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Job source: The Muse ----------------------------------------------
# Free API key at https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=

# ---- Notifications: e-mail (SMTP) -------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Notifications: Telegram -----------------------------------------
# Create a bot with @BotFather; the chat id is configured later in the UI.
TELEGRAM_BOT_TOKEN=

# =============================================================================
# FindMyJob — environment configuration
# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
# =============================================================================

# ---- Application ------------------------------------------------------------
APP_ENV=development
# Secret used to sign session cookies. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=change-me-to-a-long-random-string
# Where runtime data lives (SQLite db, uploaded documents, generated letters,
# embedding model cache). Defaults to `<repo>/data` if unset.
# APP_DATA_DIR=/Users/you/Library/Application Support/FindMyJob
# Override the DB URL if you don't want the default sqlite file under APP_DATA_DIR.
# APP_DATABASE_URL=sqlite:///./data/findmyjob.db
APP_HOST=127.0.0.1
APP_PORT=8000
# Set true to stop the in-process daily scheduler (e.g. if you rely only on launchd).
APP_DISABLE_SCHEDULER=false

# ---- LLM (Anthropic / Claude) ---------------------------------------------
ANTHROPIC_API_KEY=
# Set true to skip every model call and use canned, schema-valid responses.
# Lets you click through the whole app (analyze / score / judge / cover letter)
# with no API key and zero cost. The output is placeholder text - not for real use.
LLM_OFFLINE=false

# ---- Using a free / non-Anthropic model (real output, no Anthropic bill) ----
# Point the client at any OpenAI-compatible /chat/completions endpoint. Model
# names change often - fetch each provider's model list and use a "-latest" alias
# where one exists. Prefer a NON-thinking / "lite" model for the cheap tier
# (thinking models can burn the whole token budget before emitting JSON).
#   Gemini   LLM_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#            LLM_MODEL_CHEAP / _SMART = gemini-flash-lite-latest / gemini-flash-latest
#            free key (no card): https://aistudio.google.com/apikey   -- best free tier
#   Groq     LLM_OPENAI_BASE_URL=https://api.groq.com/openai/v1
#            LLM_MODEL_CHEAP / _SMART = groq/compound-mini (8k tok/min on most others)
#   Cerebras LLM_OPENAI_BASE_URL=https://api.cerebras.ai/v1
#   Ollama   LLM_OPENAI_BASE_URL=http://localhost:11434/v1      (no key needed)
LLM_PROVIDER=anthropic
LLM_OPENAI_BASE_URL=
LLM_OPENAI_API_KEY=
# Min seconds between calls to an OpenAI-compatible endpoint - paces free tiers.
LLM_MIN_INTERVAL_S=1.5

# Model routing — cheap model for bulk extraction, capable model for judgement
# and cover letters. For LLM_PROVIDER=openai set these to that provider's model IDs.
LLM_MODEL_CHEAP=claude-haiku-4-5-20251001
LLM_MODEL_SMART=claude-sonnet-5
# Hard ceiling on spend per calendar month, in EUR. The pipeline stops making
# LLM calls once month-to-date cost would exceed this.
LLM_MONTHLY_BUDGET_EUR=10
# Approximate prices, EUR per 1M tokens (input / output). Update to current rates.
LLM_PRICE_CHEAP_IN=0.80
LLM_PRICE_CHEAP_OUT=4.00
LLM_PRICE_SMART_IN=2.80
LLM_PRICE_SMART_OUT=14.00

# ---- Job source: Bundesagentur fuer Arbeit (Jobsuche API) -----------------
# Register at https://jobsuche.api.bund.dev / https://www.arbeitsagentur.de
BA_API_CLIENT_ID=
BA_API_CLIENT_SECRET=

# ---- Job source: Adzuna --------------------------------------------------
# Free API key at https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# ---- Job source: The Muse ----------------------------------------------
# Free API key at https://www.themuse.com/developers/api/v2
THEMUSE_API_KEY=

# ---- Notifications: e-mail (SMTP) -------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# ---- Notifications: Telegram -----------------------------------------
# Create a bot with @BotFather; the chat id is configured later in the UI.
TELEGRAM_BOT_TOKEN=
